# Server port
PORT=8017

# Optional API key for authenticating requests from Pi (Authorization: Bearer <token>)
PI_BRIDGE_API_KEY=

# Discord Bot Token (required)
PI_BRIDGE_DISCORD_TOKEN=

# Default Discord Channel ID for notifications and questions (optional if provided in request)
DISCORD_HOME_CHANNEL=

# Comma-separated allowed Discord User IDs (empty = all users in channel are allowed)
DISCORD_ALLOWED_USERS=

# Delay in seconds before sending a reminder ping if a question is unanswered (default: 60, 0 to disable)
DISCORD_REMINDER_DELAY_SECONDS=60
